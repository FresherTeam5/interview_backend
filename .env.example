# Sao chep file nay thanh .env va dien cac gia tri bi de trong.
# Khong commit file .env. Production phai khai bao cac bien trong Render Environment.

# Runtime
PORT=8080
# Chi co tac dung khi duoc export vao OS hoac khai bao tren Render.
JAVA_TOOL_OPTIONS=-Xms64m -Xmx300m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC

# Database
DB_URL=jdbc:mysql://localhost:3306/interview_thaitruong?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=123456
LIQUIBASE_ENABLED=true

# Mail
MAIL_ENABLED=false
MAIL_FROM=no-reply@my-interview.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# OpenRouter / Spring AI
# Bat buoc: dien API key that truoc khi chay ung dung.
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=25s
AI_MAX_RETRIES=0
AI_MODEL=inclusionai/ling-3.0-flash-sante:free
AI_TEMPERATURE=0.1

# Swagger
SWAGGER_ENABLED=true

# Frontend, CORS and account lifecycle
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_TOKEN_CLEANUP_CRON=0 15 2 * * *
ACCOUNT_DELETION_CRON=0 */15 * * * *
STORAGE_DELETION_CRON=30 */5 * * * *

# Initial administrator
APP_ADMIN_BOOTSTRAP_ENABLED=false
APP_ADMIN_BOOTSTRAP_EMAIL=
APP_ADMIN_BOOTSTRAP_PASSWORD=
APP_ADMIN_BOOTSTRAP_FULL_NAME=System Administrator

# Authentication
# Bat buoc: dung chuoi ngau nhien dai it nhat 32 ky tu.
JWT_SECRET=
JWT_EXPIRATION_MS=9000000
REFRESH_TOKEN_EXPIRATION_MS=604800000
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/auth
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
REFRESH_TOKEN_CLEANUP_CRON=0 0 2 * * *

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com

# S3 / MinIO / Cloudflare R2
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=interview-store
STORAGE_REGION=us-east-1

# CV
CV_MAX_FILE_SIZE_BYTES=5242880
CV_MAX_PAGES=10
CV_MAX_PER_USER=10

# Job description
JD_MAX_FILE_SIZE_BYTES=5242880
JD_MAX_PAGES=20
JD_MAX_PER_USER=50
JD_MAX_TEXT_CHARACTERS=30000

# Interview
INTERVIEW_SUPPORTED_LANGUAGES=vi,en,ja
INTERVIEW_SUPPORTED_DURATIONS=15,30,45,60
INTERVIEW_SUPPORTED_MODES=TURN_BASED
INTERVIEW_DEADLINE_SWEEP_MS=30000
INTERVIEW_MINIMUM_SCORING_COVERAGE=50
INTERVIEW_TECHNICAL_SCORE_WEIGHT=0.8
INTERVIEW_COMMUNICATION_SCORE_WEIGHT=0.2

# Scheduled admin jobs
ADMIN_ANNOUNCEMENT_CRON=0 * * * * *
ADMIN_JOB_HISTORY_CLEANUP_CRON=0 30 3 * * *
ADMIN_JOB_RECOVERY_MS=3600000

# Gemini Live realtime interview
REALTIME_ENABLED=false
REALTIME_PROVIDER=gemini-live
GEMINI_API_KEY=
GEMINI_LIVE_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_LIVE_WEBSOCKET_ENDPOINT=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_DEFAULT_VOICE=Kore
GEMINI_LIVE_SUPPORTED_VOICES=Zephyr,Puck,Charon,Kore,Fenrir,Leda,Orus,Aoede,Callirrhoe,Autonoe,Enceladus,Iapetus,Umbriel,Algieba,Despina,Erinome,Algenib,Rasalgethi,Laomedeia,Achernar,Alnilam,Schedar,Gacrux,Pulcherrima,Achird,Zubenelgenubi,Vindemiatrix,Sadachbia,Sadaltager,Sulafat
GEMINI_LIVE_CONNECT_TIMEOUT=5s
GEMINI_LIVE_READ_TIMEOUT=15s
GEMINI_LIVE_NEW_SESSION_TTL=1m
GEMINI_LIVE_TOKEN_LIFETIME_BUFFER=15m
GEMINI_LIVE_INPUT_SAMPLE_RATE=16000
GEMINI_LIVE_OUTPUT_SAMPLE_RATE=24000

# ElevenLabs speech-to-text and text-to-speech
SPEECH_ENABLED=false
SPEECH_STT_PROVIDER=elevenlabs
SPEECH_TTS_PROVIDER=elevenlabs
SPEECH_MAX_AUDIO_SIZE_BYTES=10485760
SPEECH_CONNECT_TIMEOUT=5s
SPEECH_READ_TIMEOUT=45s
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_VOICE_EN=sDLPLA42F3JDFlBx0oRp
ELEVENLABS_VOICE_JA=sDLPLA42F3JDFlBx0oRp
ELEVENLABS_VOICE_VI=sDLPLA42F3JDFlBx0oRp
